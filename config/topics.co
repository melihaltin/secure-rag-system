define bot refuse_blocked_input
  "⚠️ SECURITY WARNING: Salary and financial data are confidential and cannot be shared."

define bot refuse_blocked_output
  "🚫 SECURITY WARNING: The system detected sensitive data (salary information) and blocked the response."

# ============================================
# AKIŞLAR
# ============================================


# ANA SORU-CEVAP AKIŞI
define flow answer_question
  user ...
  
  # ADIM 1: INPUT KONTROLÜ
  # Python tarafındaki 'check_input_for_salary' aksiyonunu çağırıyoruz.
  # Bu aksiyon bize 'True' (tehdit var) veya 'False' (temiz) dönüyor.
  $is_salary_input = execute check_input_for_salary
  
  # HATA DÜZELTİLDİ: "yes" in kontrolü yerine doğrudan boolean kontrolü yapıyoruz.
  if $is_salary_input
    bot refuse_blocked_input
    stop

  # ADIM 2: RAG SİSTEMİNİ ÇAĞIR
  # Input temizse buraya geçer.
  $answer = execute call_rag
  
  # ADIM 3: OUTPUT KONTROLÜ
  # Python tarafındaki 'check_salary_regex' aksiyonunu çağırıyoruz.
  # Bu da 'True' veya 'False' döner.
  $is_leaking = execute check_salary_regex(text=$answer)
  
  # HATA DÜZELTİLDİ: Yine doğrudan boolean kontrolü.
  if $is_leaking
    bot refuse_blocked_output
    stop

  # ADIM 4: GÜVENLİ YANITI VER
  bot $answer