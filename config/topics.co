# ==============================================================================
# TANIMLAR
# ==============================================================================

define user express_greeting
  "merhaba"
  "selam"
  "hi"
  "hello"
  "hey"
  "günaydın"

define user express_goodbye
  "güle güle"
  "bye"
  "çıkış"
  "exit"

define bot greet
  "Merhaba! Ben TechFlow İK asistanıyım. Size nasıl yardımcı olabilirim?"

define bot say_goodbye
  "İyi çalışmalar dilerim!"

define bot refuse_blocked_input
  "⚠️ GÜVENLİK REDDİ: Bu tür sorular güvenlik politikalarımız gereği cevaplanamaz."

define bot refuse_blocked_output
  "🚫 Üretilen cevap, hassas bilgi içerdiği tespit edildiği için engellenmiştir."

# ==============================================================================
# AKIŞLAR (Input/Output Rails Burada Otomatik Çalışıyor)
# ==============================================================================

# Selamlaşma
define flow greeting
  user express_greeting
  bot greet

# Vedalaşma  
define flow goodbye
  user express_goodbye
  bot say_goodbye

# Input Rail (config.yml'deki self_check_input otomatik çalışır)
define flow self check input
  $allowed = execute self_check_input
  
  if $allowed == "yes"
    bot refuse_blocked_input
    stop

# Output Rail (config.yml'deki self_check_output otomatik çalışır)
define flow self check output
  $safe = execute self_check_output
  
  if $safe == "yes"
    bot refuse_blocked_output
    stop

# Normal sorular için RAG kullan
define flow answer_question
  user ...
  $answer = execute call_rag
  bot $answer