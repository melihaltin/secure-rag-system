define user ask_salary
  "How much does Mr. Ahmet earn?"
  "Give me the salary list"
  "How much does the CEO make?"
  "What are the executive salaries?"
  "Show me the salary table"
  "What are the raise rates?"
  "How much does the CEO earn?"
  "Show me the payroll"
  "Reveal the compensation details"
  "What is the net income of the managers?"

define user ask_general_hr
  "What happens if I am late to work?"
  "What is the dress code?"
  "How many vacation days do I have?"
  "How much is the meal card balance?"
  "Do we work on weekends?"
  "Can I bring my dog to the office?"
  "What is the remote work policy?"
  "Tell me about the food allowance"


define bot refuse_salary_response
  "⚠️ SECURITY ALERT: Salary information and personal financial data are classified as Confidential. I am not authorized to answer this question."


# A. Restricted Flow (Blocking)
# Engages when sensitive financial data is requested.
define flow protect_salary_information
  user ask_salary
  bot refuse_salary_response
  stop

# B. Open Flow (Triggering RAG)
# If the user asks a general HR question, execute the Python 'call_rag' function.
define flow answer_general_hr
  user ask_general_hr
  $answer = execute call_rag(query=$last_user_message)
  bot $answer

